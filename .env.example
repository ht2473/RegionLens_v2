# =======================================================================================
# RegionLens — шаблон переменных окружения.
# Скопируйте файл в `.env` и заполните значения. Сам `.env` в репозиторий не попадает.
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
# =======================================================================================

# --- Базовые настройки Django -----------------------------------------------------------
# Модуль настроек: config.settings.local | config.settings.production | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.local

# Секретный ключ. Сгенерировать:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=замените-на-случайное-значение-минимум-50-символов

# Режим отладки. В продакшне обязательно False.
DJANGO_DEBUG=True

# Домены, с которых принимаются запросы (через запятую).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Источники, которым доверяем CSRF-токен (обязательно со схемой).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Язык по умолчанию и часовой пояс отображения.
DJANGO_LANGUAGE_CODE=ru
DJANGO_TIME_ZONE=Europe/Moscow

# --- PostgreSQL ---------------------------------------------------------------------------
# Формат: postgres://пользователь:пароль@хост:порт/база
# На стенде в контейнерах адрес собирает docker/compose.prod.yml из POSTGRES_*,
# и значение отсюда там не используется.
DATABASE_URL=postgres://regionlens:regionlens@localhost:5432/regionlens
# Время удержания соединения в пуле, секунды (0 — закрывать после каждого запроса).
DATABASE_CONN_MAX_AGE=60

# --- Valkey: кэш и счётчики ограничителей частоты ---------------------------------------------
# На стенде в контейнерах адрес задаёт compose.
VALKEY_URL=redis://127.0.0.1:6379

# --- Разработка -------------------------------------------------------------------------------
# Панель отладки Django: добавляет к странице 130–290 мс, на карте до двух секунд.
DEBUG_TOOLBAR=False

# --- Аналитический склад DuckDB ---------------------------------------------------------------
# Путь к файлу склада относительно корня проекта.
DUCKDB_PATH=data/warehouse/regionlens.duckdb
# Предел памяти DuckDB в веб-процессе (на процесс; важно на VPS с 4 ГБ ОЗУ).
DUCKDB_MEMORY_LIMIT=256MB
# Предел памяти сборки склада: она идёт отдельным процессом, одна за раз.
DUCKDB_BUILD_MEMORY_LIMIT=1GB
# Число потоков DuckDB. Не должно превышать количество ядер VPS.
DUCKDB_THREADS=2
# Исходный набор данных Росстата (вход ETL).
SOURCE_PARQUET_PATH=data/raw/data_regions_collection_102_v20260313.parquet
# Каталог наборов, загруженных из панели управления, и предел размера файла, байт.
DATASET_UPLOAD_DIR=data/uploads
DATASET_UPLOAD_MAX_BYTES=209715200

# --- Свои данные: таблицы пользователей ---------------------------------------------------------
# Каталог таблиц (на стенде — том userdata) и пределы. Загрузка — до 25 МБ (Caddy пропускает
# к адресу загрузки чуть больше), таблица в распакованном виде — до 300 МБ.
USERDATA_DIR=data/userdata
USERDATA_UPLOAD_MAX_BYTES=26214400
USERDATA_TABLE_MAX_BYTES=314572800
# Значений в таблице после отбора разрезов: с учётной записью и без входа.
USERDATA_MAX_VALUES=1000000
USERDATA_GUEST_MAX_VALUES=200000
# Таблиц на учётную запись и у гостя, место на учётную запись (байт), срок таблицы гостя (ч).
USERDATA_MAX_DATASETS=20
USERDATA_GUEST_MAX_DATASETS=3
USERDATA_QUOTA_BYTES=209715200
USERDATA_GUEST_HOURS=24
# Загрузок в час: с учётной записи и с адреса без входа.
USERDATA_UPLOADS_PER_HOUR=20
USERDATA_GUEST_UPLOADS_PER_HOUR=10
# Разбор большой таблицы отдельным процессом: одновременно, предел времени (с), память DuckDB.
USERDATA_PARALLEL_JOBS=2
USERDATA_JOB_SECONDS=120
USERDATA_PARSE_MEMORY=768MB
# Память соединения с файлом таблицы при показе её рядов.
USERDATA_QUERY_MEMORY=128MB
# Версий таблицы на диске (значения прежних остаются в отчёте о различиях).
USERDATA_KEEP_VERSIONS=5
# Закрытые ссылки: действующих на таблицу или исследование; неудачных попыток открыть с адреса за 10 мин.
USERDATA_MAX_SHARES=10
USERDATA_SHARE_ATTEMPTS=30
# Исследования: на учётную запись, у гостя (на сутки), карточек с заметками в исследовании;
# правок поля за 10 минут с учётной записи или адреса.
USERDATA_MAX_STUDIES=20
USERDATA_GUEST_MAX_STUDIES=3
USERDATA_STUDY_BLOCKS=40
USERDATA_STUDY_EDITS=300

# --- Сбор выпусков источников (команда collect) -----------------------------------------------
# Неизменяемый архив полученных файлов и разобранные выпуски.
SOURCE_ARCHIVE_DIR=data/archive
SOURCE_PARSED_DIR=data/sources
# Распаковщик RAR (bsdtar из libarchive-tools); пусто — ищется в PATH, в Windows — tar.exe.
SOURCE_BSDTAR=
SOURCE_HTTP_TIMEOUT=60
SOURCE_HTTP_ATTEMPTS=4

# --- Почта ---------------------------------------------------------------------------------------
# Переменные читаются в настройку MAILERS (Django 6.1); одноимённые настройки EMAIL_*
# в Django устарели, а переменные — нет. В разработке письма печатаются в консоль,
# на стенде — django.core.mail.backends.smtp.EmailBackend (проверка check --deploy
# не пропустит консольную почту). Домен отправителя должен иметь записи SPF, DKIM
# и DMARC — см. docs/DEPLOYMENT.md, иначе ответы на обращения уйдут в спам.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=RegionLens <noreply@regionlens.ru>
SERVER_EMAIL=RegionLens <noreply@regionlens.ru>

# --- Защита формы входа от подбора пароля ---------------------------------------------------------
# В разработке учёт неудачных попыток ведётся по паре «адрес отправителя + введённый адрес
# почты», и после AXES_FAILURE_LIMIT попыток пара закрыта на час. На стенде
# (config/settings/production.py) — 5 попыток по адресу и по почте в отдельности,
# AXES_FAILURE_LIMIT там не действует.
AXES_ENABLED=True
AXES_FAILURE_LIMIT=8

# --- Безопасность (учитывается только в production) -------------------------------------------------
# Значения читает единственный модуль — config/settings/production.py; локальная
# разработка их не видит вовсе. Поэтому ослаблять их «ради удобства разработки»
# бессмысленно: удобства это не даёт, а рабочий стенд остаётся без перехода
# на HTTPS, без HSTS и с куками без признака Secure. Тот же файл .env compose
# передаёт в контейнер (env_file), и выставленные здесь значения оказываются
# в эксплуатации как есть.
#
# Умолчания самого модуля уже безопасны, и строки ниже нужны только для отступления
# от них — например, при проверке развёртывания на стенде без сертификата.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Наблюдаемость ------------------------------------------------------------------------------------
LOG_LEVEL=INFO
# Формат логов: console (читаемый) | json (для сбора в продакшне)
LOG_FORMAT=console
# Кому писать об ошибке 500 (одна и та же — не чаще раза в час) и о сбоях сбора и сборки
# склада (через запятую).
# На стенде обязателен этот адрес или SENTRY_DSN: иначе проверка стенда не пропустит запуск.
DJANGO_ADMINS=
SENTRY_DSN=

# --- Ограничения приложения ------------------------------------------------------------------------------
# Время жизни кэша аналитических ответов, секунды.
ANALYTICS_CACHE_TTL=3600
# Шрифт для PDF. Встроенные шрифты reportlab не содержат кириллицы; если ни один
# системный шрифт из перечня не найден, путь задаётся здесь явно.
PDF_FONT_PATH=

# --- Развёртывание в контейнерах -----------------------------------------------------------------------
# Значения ниже читает docker/compose.prod.yml. В разработке они не используются.

# Домен рабочего стенда. Caddy получит для него сертификат Let's Encrypt.
# Значение localhost означает самоподписанный сертификат и работу без выхода в интернет.
DOMAIN=localhost
# Адрес для учётной записи удостоверяющего центра. Обязателен: без него compose
# откажется запускаться (Caddy не принимает пустой адрес).
ACME_EMAIL=

# Порты, публикуемые наружу. На сервере, где 443 занят другой службой,
# укажите свободный порт — конфигурация от этого не меняется.
HTTP_PORT=80
HTTPS_PORT=443

# Учётные данные PostgreSQL в контейнере. Пароль обязателен: без него compose
# откажется запускаться, а не поднимет базу с пустым паролем. Пароль входит в адрес
# соединения, поэтому без знаков @ : / ? # — подойдёт secrets.token_urlsafe(32).
POSTGRES_DB=regionlens
POSTGRES_USER=regionlens
POSTGRES_PASSWORD=
# Настройки под объём памяти сервера. Значения рассчитаны на 4 ГБ.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=60

# Образ приложения. scripts/deploy.sh передаёт образ на сервер и ставит на него этот ярлык,
# поэтому на стенде значение не меняется.
REGIONLENS_IMAGE=regionlens:latest

# Число суток хранения резервных копий.
BACKUP_RETENTION_DAYS=14
# Хранилище rclone для вывоза копий за пределы сервера (например, selectel:regionlens-backups).
# Ключи доступа — в настройках rclone пользователя (rclone config), а не здесь: этот файл
# попадает и в контейнеры. Пусто — копии остаются только на сервере, и панель это покажет.
BACKUP_REMOTE=
# Число суток хранения копий во внешнем хранилище; 0 — хранить все.
BACKUP_REMOTE_RETENTION_DAYS=30

# --- Программный интерфейс -----------------------------------------------------------------------------
# Предел числа обращений с одного адреса.
API_ANON_RATE=1000/hour

# =====================================================================================
# Ежедневная резервная копия.
#
# Ночью обращений почти нет. Persistent=true: если в назначенный час сервер был
# выключен, копия снимается после включения.
# =====================================================================================

[Unit]
Description=RegionLens — ежедневная резервная копия

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target

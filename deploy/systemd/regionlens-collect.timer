# =====================================================================================
# Ежедневная проверка источников.
#
# Утром по Москве: бюллетень Росстата выходит в рабочие дни. Persistent=true:
# пропущенная проверка выполняется после включения сервера.
# =====================================================================================

[Unit]
Description=RegionLens — ежедневная проверка источников

[Timer]
OnCalendar=*-*-* 07:00:00 Europe/Moscow
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target

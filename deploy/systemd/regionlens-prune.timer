# =====================================================================================
# Ежедневное удаление персональных данных по сроку.
#
# Persistent=true: пропущенный запуск выполняется после включения сервера.
# =====================================================================================

[Unit]
Description=RegionLens — ежедневное удаление персональных данных по сроку

[Timer]
OnCalendar=*-*-* 04:15:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target

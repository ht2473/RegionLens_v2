# =====================================================================================
# Ежечасный пересчёт статистики посещений.
#
# Команда дочитывает только строки, появившиеся после прошлого запуска, а отчёт
# по истории небольшого сайта GoAccess считает за секунды. Persistent=true: пропущенный пересчёт
# выполняется после включения сервера.
# =====================================================================================

[Unit]
Description=RegionLens — ежечасная статистика посещений

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target

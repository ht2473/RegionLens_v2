msgstr "average annual growth rate"

#: apps/analytics/views/convergence.py:223
msgid "подобранная зависимость"
msgstr "fitted dependence"

#: apps/analytics/views/inequality.py:47
msgid "территории равнозначны"
msgstr "territories are equal"

#: apps/analytics/views/inequality.py:48
msgid "по численности населения"
msgstr "by population size"

#: apps/analytics/views/inequality.py:72
msgid "Отношение стандартного отклонения к среднему; простейшая мера разброса"
msgstr "The ratio of the standard deviation to the mean; the simplest measure of spread"

#: apps/analytics/views/inequality.py:76
msgid "Коэффициент Джини"
msgstr "Gini coefficient"

#: apps/analytics/views/inequality.py:77
msgid "От нуля при полном равенстве до единицы при полной концентрации"
msgstr "From zero under full equality to one under full concentration"

#: apps/analytics/views/inequality.py:81
msgid "Индекс Тейла"
msgstr "Theil index"

#: apps/analytics/views/inequality.py:82
msgid "Раскладывается на различия между округами и внутри округов"
msgstr "Decomposes into differences between districts and within districts"

#: apps/analytics/views/inequality.py:86
msgid "Индекс Аткинсона"
msgstr "Atkinson index"

#: apps/analytics/views/inequality.py:87
msgid "Учитывает отставание нижней части тем сильнее, чем выше параметр"
msgstr "The higher the parameter, the more weight is given to the lagging part"

#: apps/analytics/views/inequality.py:91
#: apps/surface/templates/surface/panels/_distribution.html:71
msgid "Децильный коэффициент"
msgstr "Decile ratio"

#: apps/analytics/views/inequality.py:92
msgid "Во сколько раз девятый дециль превышает первый"
msgstr "How many times the ninth decile exceeds the first"

#: apps/analytics/views/inequality.py:96

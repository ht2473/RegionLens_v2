# --- Виртуальное окружение и артефакты Python ------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- Секреты и локальная конфигурация ---------------------------------------------------
.env
.env.local
.env.production
*.pem
*.key

# --- Данные -------------------------------------------------------------------------------
# Исходный parquet (9 МБ) — вход сборки склада и хранится в репозитории;
# всё собираемое из него воспроизводится командой `etl_build`.
data/warehouse/*.duckdb
data/warehouse/*.duckdb.wal
data/warehouse/*.duckdb.tmp/
data/warehouse/parquet/
data/raw/*.csv
data/raw/*.xlsx
data/tmp/
# Наборы, загруженные из панели управления; архив выпусков источников и их разбор.
data/uploads/
data/archive/
data/sources/
data/visits/
# Таблицы пользователей («Свои данные»).
data/userdata/

# --- Пользовательские файлы и выгрузки ----------------------------------------------------
staticfiles/

# --- Логи -----------------------------------------------------------------------------------
logs/
*.log

# --- Среда разработки ------------------------------------------------------------------------
.idea/
.vscode/
# Отчёты счётчика строк.
.VSCodeCounter/
*.swp
.DS_Store
Thumbs.db

# --- Сборка фронтенда ----------------------------------------------------------------------------
# Каталог одноразовой сборки ECharts (scripts/echarts/README.md).
node_modules/

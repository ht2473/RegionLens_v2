# =====================================================================================
# Что не попадает в контекст сборки образа.
#
# Всё попавшее в контекст может попасть в слой образа: .env, ключи и выгрузки базы
# туда не должны попасть.
# =====================================================================================

# --- Секреты ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
backups/

# --- Виртуальное окружение и кэши ------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- Данные, воспроизводимые командами ----------------------------------------------------------
# Исходный parquet нужен образу: из него собирается склад. Сам склад — нет.
data/warehouse/
data/tmp/
# Наборы, загруженные из панели, архив выпусков источников и их разбор.
data/uploads/
data/archive/
data/sources/
data/visits/
staticfiles/
logs/

# --- Разработка ------------------------------------------------------------------------------------
# Скрытые каталоги: git, CI, настройки редакторов и локальные файлы разработчика.
.*/
tests/
docs/
*.md
!README.md
.pre-commit-config.yaml
.editorconfig
.gitattributes
.gitignore
docker/compose.dev.yml
